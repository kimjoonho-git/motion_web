<?xml version="1.0"?>
<package format="3">
  <name>midi_control</name>
  <version>0.1.0</version>
  <description>MIDI state, mapping, filtering, and device-feedback control.</description>
  <maintainer email="joonho_test@example.com">joonho_test</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>motion_common</depend>
