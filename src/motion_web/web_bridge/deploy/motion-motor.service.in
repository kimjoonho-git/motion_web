[Unit]
Description=Motion Control Persistent Motor Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
Environment="MOTION_WORKSPACE=@WORKSPACE@"
# 네트워크 개방과 DDS 도메인·이름공간은 실행 스크립트가 그룹 설정에서
# 정한다 · §6-96 · 도로 잠그려면 MOTION_GROUP_NETWORK=0
Environment="MOTION_GROUP_NETWORK=1"
ExecStart=/bin/bash @MOTOR_SERVICE_RUNNER@
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=8
LimitRTPRIO=99
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target
