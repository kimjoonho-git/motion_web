[Unit]
Description=Motion DDS Group Coordination Service
# 랜을 기다리는 일은 실행 스크립트가 한다 · §6-96
#
# 여기에 `After=network-online.target` 을 적었던 적이 있는데 **아무 일도 하지
# 않았다** · 그 타깃은 시스템 스코프에만 있고 이건 사용자 서비스라, systemd 가
# 없는 유닛으로 보고 조용히 넘어간다 · 지키지 못하는 약속을 적어 두면 다음
# 사람이 또 속으므로 지웠다 · 실제 대기는 `motion_common/net_ready.py` 가 한다.

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
Environment="MOTION_WORKSPACE=@WORKSPACE@"
Environment="ROS_LOCALHOST_ONLY=0"
ExecStart=/bin/bash @COORDINATION_SERVICE_RUNNER@
Restart=on-failure
RestartSec=3
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=8

[Install]
WantedBy=default.target
